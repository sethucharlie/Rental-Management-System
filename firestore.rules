rules_version = '2';

// Tenants sign through the app's server (firebase-admin), which bypasses these rules.
// The browser may touch tenant data only as the landlord, from the dashboard.
// A landlord is a Google account carrying the `landlord` custom claim, which
// `npm run grant-landlord` sets. No address appears here, so none is published.
service cloud.firestore {
  match /databases/{database}/documents {

    function isLandlord() {
      return request.auth != null && request.auth.token.landlord == true;
    }

    match /tenants/{tenantId} {
      allow read, write: if isLandlord();
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
