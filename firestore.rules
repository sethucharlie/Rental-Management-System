rules_version = '2';

// The browser never reads or writes Firestore. Tenants sign, and the landlord uses the
// dashboard, through the app's server (firebase-admin), which bypasses these rules and
// checks for itself that dashboard requests come from the landlord.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
